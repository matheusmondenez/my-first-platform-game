; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="my-first-platform-game"
run/main_scene="res://wave_shooter/ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "Mobile")

[autoload]

Global="*res://wave_shooter/singletons/global.gd"
Configs="*res://wave_shooter/singletons/configs.gd"
Helpers="*res://wave_shooter/singletons/helpers.gd"
PowerUpManager="*res://wave_shooter/singletons/power_up_manager.gd"
SkillManager="*res://wave_shooter/singletons/skill_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
mouse_cursor/custom_image="res://wave_shooter/assets/ui/aim.png"
mouse_cursor/custom_image_hotspot=Vector2(24, 24)

[file_customization]

folder_colors={
"res://wave_shooter/assets/": "orange",
"res://wave_shooter/build/": "green",
"res://wave_shooter/entities/": "blue",
"res://wave_shooter/fx/": "pink",
"res://wave_shooter/levels/": "yellow",
"res://wave_shooter/resoures/": "purple",
"res://wave_shooter/shaders/": "teal",
"res://wave_shooter/singletons/": "gray",
"res://wave_shooter/ui/": "green"
}

